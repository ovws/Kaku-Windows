Unicode true
!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"
!include "Sections.nsh"
!include "nsDialogs.nsh"
Name "Kaku for Windows"
OutFile "@OUTPUT@"
InstallDir "$LOCALAPPDATA\Programs\Kaku"
InstallDirRegKey HKCU "Software\KakuWindows" "InstallDir"
RequestExecutionLevel user
SetCompressor /SOLID lzma
SetCompressorDictSize 32
BrandingText "Kaku for Windows"
!define MUI_ABORTWARNING
!define MUI_ICON "@ICON@"
!define MUI_UNICON "@ICON@"
Var InstallPathControl
Var MesaControl
Var DesktopControl
Page custom InstallSettingsCreate InstallSettingsLeave "Install"
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\Kaku.exe"
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Section "Kaku (required)" SEC_CORE
  SectionIn RO
  ; Reject an upgrade while the existing GUI executable is in use.
  IfFileExists "$INSTDIR\Kaku.exe" 0 ready
  System::Call 'kernel32::CreateFileW(w "$INSTDIR\Kaku.exe", i 0x40000000, i 0, p 0, i 3, i 0, p 0) p .r0'
  ${If} $0 == -1
    MessageBox MB_OK|MB_ICONEXCLAMATION "Close Kaku before installing, and check that the installation folder is writable."
    Abort
  ${EndIf}
  System::Call 'kernel32::CloseHandle(p r0)'
ready:
  @CORE_FILES@
  SetOutPath "$INSTDIR"
  File /oname=kaku.ico "@ICON@"
  SetOutPath "$INSTDIR"
  ; Preserve an existing installation's personal bundled config on upgrade.
  IfFileExists "$INSTDIR\kaku.lua" config_done
  File "@CONFIG@"
config_done:
  ; Keep both required GUI names while storing their bytes only once on NTFS.
  Delete "$INSTDIR\kaku-gui.exe"
  System::Call 'kernel32::CreateHardLinkW(w "$INSTDIR\kaku-gui.exe", w "$INSTDIR\Kaku.exe", p 0) i .r0'
  ${If} $0 == 0
    ClearErrors
    CopyFiles /SILENT "$INSTDIR\Kaku.exe" "$INSTDIR\kaku-gui.exe"
    ${If} ${Errors}
      MessageBox MB_OK|MB_ICONSTOP "Unable to create the GUI companion executable."
      Abort
    ${EndIf}
  ${EndIf}
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  CreateDirectory "$SMPROGRAMS\Kaku"
  CreateShortcut "$SMPROGRAMS\Kaku\Kaku.lnk" "$INSTDIR\Kaku.exe" "" "$INSTDIR\kaku.ico" 0
  CreateShortcut "$SMPROGRAMS\Kaku\Uninstall Kaku.lnk" "$INSTDIR\Uninstall.exe" "" "$INSTDIR\kaku.ico" 0
  WriteRegStr HKCU "Software\KakuWindows" "InstallDir" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows" "DisplayName" "Kaku for Windows"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows" "DisplayVersion" "@VERSION@"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows" "DisplayIcon" "$INSTDIR\kaku.ico"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows" "NoRepair" 1
SectionEnd

Section /o "Software OpenGL fallback (older GPUs / remote desktop)" SEC_MESA
  @MESA_FILES@
SectionEnd

Section /o "Desktop shortcut" SEC_DESKTOP
  CreateShortcut "$DESKTOP\Kaku.lnk" "$INSTDIR\Kaku.exe" "" "$INSTDIR\kaku.ico" 0
SectionEnd



Section "Uninstall"
  SetShellVarContext current
  @UNINSTALL_FILES@
  Delete "$INSTDIR\kaku.ico"
  Delete "$INSTDIR\Uninstall.exe"
  Delete "$DESKTOP\Kaku.lnk"
  Delete "$SMPROGRAMS\Kaku\Kaku.lnk"
  Delete "$SMPROGRAMS\Kaku\Uninstall Kaku.lnk"
  RMDir "$SMPROGRAMS\Kaku"
  ; No recursive deletion: retain kaku.lua and any user-created files.
  RMDir "$INSTDIR"
  DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\KakuWindows"
  DeleteRegKey HKCU "Software\KakuWindows"
SectionEnd

Function .onInit
  SetShellVarContext current
  ; Retain optional components already installed during an upgrade.
  IfFileExists "$INSTDIR\mesa\opengl32.dll" 0 +2
    SectionSetFlags ${SEC_MESA} ${SF_SELECTED}
  IfFileExists "$DESKTOP\Kaku.lnk" 0 +2
    SectionSetFlags ${SEC_DESKTOP} ${SF_SELECTED}
  ${GetParameters} $0
  ClearErrors
  ${GetOptions} $0 "/MESA" $1
  ${IfNot} ${Errors}
    SectionSetFlags ${SEC_MESA} ${SF_SELECTED}
  ${EndIf}
FunctionEnd

Function un.onInit
  SetShellVarContext current
  IfFileExists "$INSTDIR\Kaku.exe" 0 ready
  System::Call 'kernel32::CreateFileW(w "$INSTDIR\Kaku.exe", i 0x40000000, i 0, p 0, i 3, i 0, p 0) p .r0'
  ${If} $0 == -1
    MessageBox MB_OK|MB_ICONEXCLAMATION "Close Kaku before uninstalling, and check that the installation folder is writable."
    Abort
  ${EndIf}
  System::Call 'kernel32::CloseHandle(p r0)'
ready:
FunctionEnd

Function InstallSettingsCreate
  !insertmacro MUI_HEADER_TEXT "Install Kaku" "A compact terminal for your Windows account."
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}
  ${NSD_CreateLabel} 0 0 100% 22u "Installs without administrator rights. Your existing configuration is kept when updating."
  Pop $0
  ${NSD_CreateLabel} 0 28u 100% 10u "Install folder"
  Pop $0
  ${NSD_CreateDirRequest} 0 42u 80% 13u "$INSTDIR"
  Pop $InstallPathControl
  ${NSD_CreateBrowseButton} 82% 42u 18% 13u "Browse..."
  Pop $0
  ${NSD_OnClick} $0 BrowseInstallFolder
  ${NSD_CreateCheckbox} 0 66u 100% 12u "Create a desktop shortcut"
  Pop $DesktopControl
  SectionGetFlags ${SEC_DESKTOP} $0
  IntOp $0 $0 & ${SF_SELECTED}
  ${NSD_SetState} $DesktopControl $0
  ${NSD_CreateCheckbox} 0 85u 100% 12u "Include software OpenGL fallback (+36 MB)"
  Pop $MesaControl
  SectionGetFlags ${SEC_MESA} $0
  IntOp $0 $0 & ${SF_SELECTED}
  ${NSD_SetState} $MesaControl $0
  ${NSD_CreateLabel} 12u 100u 95% 20u "Useful for older GPUs or remote desktop rendering problems. You can add it later by running this installer again."
  Pop $0
  ${NSD_CreateLabel} 0 127u 100% 18u "Default installation: approximately 66 MB on NTFS. License and notices are included in the installation folder."
  Pop $0
  GetDlgItem $0 $HWNDPARENT 1
  SendMessage $0 ${WM_SETTEXT} 0 "STR:Install"
  nsDialogs::Show
FunctionEnd

Function BrowseInstallFolder
  Pop $0
  ${NSD_GetText} $InstallPathControl $1
  nsDialogs::SelectFolderDialog "Choose the Kaku installation folder" $1
  Pop $0
  ${If} $0 != error
    ${NSD_SetText} $InstallPathControl $0
  ${EndIf}
FunctionEnd

Function InstallSettingsLeave
  ${NSD_GetText} $InstallPathControl $INSTDIR
  ${If} $INSTDIR == ""
    MessageBox MB_OK|MB_ICONEXCLAMATION "Choose an installation folder."
    Abort
  ${EndIf}
  ${NSD_GetState} $MesaControl $0
  SectionSetFlags ${SEC_MESA} $0
  ${NSD_GetState} $DesktopControl $0
  SectionSetFlags ${SEC_DESKTOP} $0
FunctionEnd
